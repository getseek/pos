        {
          "path": "Software/tests/GetSeek.IntegrationTests/ImportResultWorkbookTests.cs",
          "sha256": "d4837e65cfce1bfdc0791aa2a3fd3c60c6f944b4a94c2bac194d3541650f65dd",
